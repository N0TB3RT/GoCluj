# Copy this file to .env and adjust the values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# --- Database (PostgreSQL) ---
POSTGRES_USER=gocluj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gocluj
# Used by the backend. "db" is the database service name inside Docker.
DATABASE_URL=postgresql+psycopg2://gocluj:change-me@db:5432/gocluj

# --- pgAdmin (database UI at http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@gocluj.dev
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Frontend ---
# No root variables needed: the frontend calls /api through the Vite proxy
# (API_PROXY_TARGET=http://backend:8000 is set in frontend/Dockerfile).
# To run it outside Docker, see frontend/.env.example.

# --- Backend CORS: comma-separated allowed origins ---
CORS_ORIGINS=http://localhost:3000

# --- Scraper (optional) ---
# Leave INGEST_URL empty for a dry run (events are only saved to files).
INGEST_URL=http://backend:8000/api/ingest/events
# Shared by the backend and the scraper.
INGEST_TOKEN=change-me
# 1 = cache downloaded pages locally (development only)
HTTPCACHE_ENABLED=0
SCRAPER_LOG_LEVEL=INFO
