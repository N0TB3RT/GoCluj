# Copy this file to .env and adjust the values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# --- Database (PostgreSQL) ---
POSTGRES_USER=gocluj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gocluj
# Used by the backend. "db" is the database service name inside Docker.
DATABASE_URL=postgresql+psycopg2://gocluj:change-me@db:5432/gocluj

# --- pgAdmin (database UI at http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@gocluj.dev
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Frontend ---
# Will be renamed to VITE_API_URL in OPS-01 (Vite only exposes VITE_* variables).
REACT_APP_API_URL=http://localhost:8000

# --- Scraper (optional) ---
# Leave INGEST_URL empty for a dry run: events are only saved to files.
INGEST_URL=
INGEST_TOKEN=
# 1 = cache downloaded pages locally (development only)
HTTPCACHE_ENABLED=0
SCRAPER_LOG_LEVEL=INFO
