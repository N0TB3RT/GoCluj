# Empty = same-origin /api/events, forwarded by Vite to API_PROXY_TARGET.
# Alternatively: VITE_API_URL=http://localhost:8000 (backend CORS required).
VITE_API_URL=

# Used by the Vite server only, never exposed to the browser.
# Dockerfile sets this to http://backend:8000 inside Docker Compose.
API_PROXY_TARGET=http://localhost:8000
